# ============================================================================
# 环境变量模板
# ============================================================================
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 排除，不会进仓库。
#
#   cp .env.example .env
#
# 说明：本项目的所有变量**都有合理默认值**，通常一个都不用设。
#       只有项目被搬到别的位置、或需要隔离输出时才需要覆盖。
#       恶意或错误的取值不会导致静默错误——取值异常会在自检时报出来。
# ============================================================================

# ---- 项目根目录 ------------------------------------------------------------
# 默认从文件位置自推导（integration/ 的上一级），因此搬走项目也不需要设。
# 仅在需要指向别处的技能注册表/资源时设置。
# AITOCI_ROOT=/absolute/path/to/project

# ---- 输出与资源 ------------------------------------------------------------
# 运行产物落盘目录。默认 <ROOT>/outputs
# AITOCI_OUTPUTS=/absolute/path/to/outputs
# 集成层目录。默认 <ROOT>/integration
# AITOCI_INTEGRATION=/absolute/path/to/integration
# 只读资源目录（上游脚本镜像等）。默认 <ROOT>/source
# AITOCI_RESOURCES=/absolute/path/to/source

# ---- 契约与编排 ------------------------------------------------------------
# 技能 I/O 注册表。默认 integration/data_contracts/specs/skill_io_spec.json
# AITOCI_SKILL_SPEC=/absolute/path/to/skill_io_spec.json
# 流水线定义。默认 integration/pipelines/workflow.yaml
# AITOCI_WORKFLOW=/absolute/path/to/workflow.yaml

# ---- 安全接口 --------------------------------------------------------------
# 熔断策略：off | default | strict
#   off     关闭切断，但会在报告里留痕（enabled=false）
#   default 只对"接口失效 / 数据不可信"即刻切断
#   strict  额外对"降级冒充"即刻切断
# CLI 的 --breaker 优先于此变量。
# AITOCI_BREAKER_POLICY=default

# ---- 可复现性 --------------------------------------------------------------
# =1 时血缘与落盘时间戳由输入派生，同输入产出逐字节一致。
# AITOCI_DETERMINISTIC=1

# ---- R 原生通道（可选）-----------------------------------------------------
# R 包库位置。留空时自动回退到 <ROOT>/rlibs。
# R_LIBS_USER=/absolute/path/to/rlibs
# 若你的 R 已装在标准位置，通常什么都不用设。

# ---- Windows 控制台编码 ----------------------------------------------------
# 代码内已兜底；显式设置可避免极少数环境下的乱码。
# PYTHONUTF8=1
